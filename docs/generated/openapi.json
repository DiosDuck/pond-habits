    "components": {
        "schemas": {
            "AdminUserResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "role": {
                        "type": "string",
                        "enum": [
                            "admin",
                            "user"
                        ]
                    },
                    "disabled": {
                        "type": "boolean"
                    },
                    "joined_at": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "id",
                    "name",
                    "email",
                    "role",
                    "disabled",
                    "joined_at"
                ],
                "title": "AdminUserResource"
            },
            "ChangePasswordRequest": {
                "type": "object",
                "properties": {
                    "current_password": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "password": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "password_confirmation": {
                        "type": "string",
                        "maxLength": 255
                    }
                },
                "required": [
                    "current_password",
                    "password",
                    "password_confirmation"
                ],
                "title": "ChangePasswordRequest"
            },
            "CheckInviteRequest": {
                "type": "object",
                "properties": {
                    "token": {
                        "type": "string",
                        "maxLength": 255
                    }
                },
                "required": [
                    "token"
                ],
                "title": "CheckInviteRequest"
            },
            "ForgotPasswordRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 255
                    }
                },
                "required": [
                    "email"
                ],
                "title": "ForgotPasswordRequest"
            },
            "LoginRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 255
                    },
                    "password": {
                        "type": "string",
                        "maxLength": 255
                    }
                },
                "required": [
                    "email",
                    "password"
                ],
                "title": "LoginRequest"
            },
            "MeResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "role": {
                        "type": "string",
                        "enum": [
                            "admin",
                            "user"
                        ]
                    },
                    "timezone": {
                        "type": "string"
                    },
                    "theme": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "email",
                    "role",
                    "timezone",
                    "theme"
                ],
                "title": "MeResource"
            },
            "RegisterRequest": {
                "type": "object",
                "description": "Registration from an invite (docs/product/invites.md). The email is not an input:\nthe server takes it from the invite.",
                "properties": {
                    "token": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "name": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "password": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "timezone": {
                        "type": "string"
                    },
                    "password_confirmation": {
                        "type": "string",
                        "maxLength": 255
                    }
                },
                "required": [
                    "token",
                    "name",
                    "password",
                    "timezone",
                    "password_confirmation"
                ],
                "title": "RegisterRequest"
            },
            "SendInviteRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 255
                    }
                },
                "required": [
                    "email"
                ],
                "title": "SendInviteRequest"
            },
            "SetPasswordRequest": {
                "type": "object",
                "properties": {
                    "token": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 255
                    },
                    "password": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "password_confirmation": {
                        "type": "string",
                        "maxLength": 255
                    }
                },
                "required": [
                    "token",
                    "email",
                    "password",
                    "password_confirmation"
                ],
                "title": "SetPasswordRequest"
            },
            "UpdateSettingsRequest": {
                "type": "object",
                "description": "Only these fields can change here. The email and the role are not on this list.",
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "timezone": {
                        "type": "string"
                    },
                    "theme": {
                        "type": "string",
                        "enum": [
                            "system",
                            "light",
                            "dark"
                        ]
                    }
                },
                "title": "UpdateSettingsRequest"
            },
            "UserResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "role": {
                        "type": "string",
                        "enum": [
                            "admin",
                            "user"
                        ]
                    }
                },
                "required": [
                    "id",
                    "name",
                    "email",
                    "role"
                ],
                "title": "UserResource"
            }
        },
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            },
            "AuthenticationException": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
