{
    "openapi": "3.1.2",
    "info": {
        "title": "Pond Habits",
        "version": "0.0.1"
    },
    "servers": [
        {
            "url": "http://localhost:8080/api"
        }
    ],
    "paths": {
        "/admin/invites/{invite}": {
            "delete": {
                "operationId": "admin.invites.destroy",
                "tags": [
                    "CancelInvite"
                ],
                "parameters": [
                    {
                        "name": "invite",
                        "in": "path",
                        "required": true,
                        "description": "The invite ID",
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    }
                }
            }
        },
        "/invites/check": {
            "post": {
                "operationId": "invites.check",
                "tags": [
                    "CheckInvite"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CheckInviteRequest"
