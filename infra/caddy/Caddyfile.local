# Local Caddy: one origin for the API and the frontend. Production has the same layout (ADR 0005).
{
	admin off
	auto_https off
}

(backend) {
	@backend path /api/* /sanctum/* /docs/* /health
	handle @backend {
		root * /workspace/backend/public
		php_fastcgi api:9000
	}
}

# http://localhost:8080: development. The Vite dev server, with hot reload over a WebSocket.
:80 {
	import backend
	handle {
		reverse_proxy web:5173
	}
}

# http://localhost:8081: preview of the production build (frontend/dist), like production.
# Lighthouse measures this site. Run "make build-frontend" first.
:81 {
	encode zstd gzip
	import backend
	handle {
		root * /workspace/frontend/dist
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
