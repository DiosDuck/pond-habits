# Laravel settings for one stack. Secrets: the deploy job writes this file from the
# GitHub Environment secrets, mode 0600. Never commit the real file.
APP_NAME="Pond Habits"
APP_ENV=staging
APP_KEY=base64:<php artisan key:generate --show>
APP_DEBUG=false
APP_URL=https://staging.pondhabits.com

DB_DATABASE=pond
DB_USERNAME=pond
DB_PASSWORD=<random, the same as POSTGRES_PASSWORD in db.env>

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=staging.pondhabits.com
SANCTUM_STATEFUL_DOMAINS=staging.pondhabits.com
CACHE_STORE=database
QUEUE_CONNECTION=database

# Production only (task 12). Staging uses Mailpit (compose.staging.yaml).
MAIL_MAILER=smtp
MAIL_HOST=<mail provider SMTP host>
MAIL_PORT=587
MAIL_USERNAME=<mail provider user>
MAIL_PASSWORD=<mail provider key>
MAIL_FROM_ADDRESS=<sender address at the domain>
MAIL_FROM_NAME="Pond Habits"
