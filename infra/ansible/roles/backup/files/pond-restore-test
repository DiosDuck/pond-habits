#!/usr/bin/env bash
# Monthly restore test (ADR 0013). A systemd timer starts it (roles/backup).
# It restores the newest snapshot into a temporary PostgreSQL container with small limits
# (production keeps the rest of the server), checks the data, removes the container and pings
# the heartbeat: success, or "/fail" on any error. It never touches the production database.
set -euo pipefail

# Export each value, so that "docker run -e NAME" passes it to the restic container.
set -a
# shellcheck source=/dev/null
source "${POND_BACKUP_ENV:-/etc/pond-backup/env}"
set +a
: "${RESTIC_REPOSITORY:?}" "${RESTIC_PASSWORD:?}" "${RESTIC_IMAGE:?}" "${RESTORE_HEARTBEAT_URL:?}"
POSTGRES_IMAGE=${POSTGRES_IMAGE:-postgres:18-alpine}

ping() { curl -fsS -m 10 --retry 3 -o /dev/null "$1" || echo "pond-restore-test: heartbeat ping failed" >&2; }
fail() {
  echo "pond-restore-test: $*" >&2
  exit 1
}

name=pond-restore-test-$$
# One place reports a failure: the exit hook, with the exit code. It runs once, and it always
# removes the temporary database.
finish() {
  local code=$?
  docker rm -f "$name" > /dev/null 2>&1 || true
  if [ "$code" -ne 0 ]; then
    echo "pond-restore-test: FAILED (exit $code)" >&2
    ping "$RESTORE_HEARTBEAT_URL/fail"
  fi
}
trap finish EXIT

restic() {
  docker run --rm -i --network "${RESTIC_NETWORK:-bridge}" \
    -e RESTIC_REPOSITORY -e RESTIC_PASSWORD -e AWS_ACCESS_KEY_ID -e AWS_SECRET_ACCESS_KEY \
    -v pond-restic-cache:/root/.cache/restic "$RESTIC_IMAGE" "$@"
}
sql() { docker exec "$name" psql -U postgres -d restore -tAc "$1"; }

# The newest snapshot must be less than 26 hours old: the nightly backup ran.
latest=$(restic snapshots --host pond --tag production --latest 1 --json |
  python3 -c 'import sys,json; s=json.load(sys.stdin); print(s[-1]["time"] if s else "")')
[ -n "$latest" ] || fail "no snapshot"
age=$(( $(date +%s) - $(date -d "$latest" +%s) ))
[ "$age" -lt $((26 * 3600)) ] || fail "the newest snapshot is $((age / 3600)) hours old"

docker run -d --name "$name" --network none --cpus 0.5 --memory 512m \
  -e POSTGRES_PASSWORD=restore-test -e POSTGRES_DB=restore "$POSTGRES_IMAGE" > /dev/null
for _ in $(seq 1 60); do
  docker exec "$name" pg_isready -U postgres -d restore > /dev/null 2>&1 && break
  sleep 1
done

echo "pond-restore-test: restore the snapshot from $latest"
restic dump --host pond --tag production latest production.dump |
  docker exec -i "$name" pg_restore -U postgres -d restore --no-owner --no-privileges

# The tables exist and have rows.
for table in migrations users; do
  rows=$(sql "SELECT count(*) FROM $table")
  [ "$rows" -gt 0 ] || fail "the table $table is empty"
  echo "pond-restore-test: $table has $rows rows"
done

ping "$RESTORE_HEARTBEAT_URL"
echo "pond-restore-test: OK"
